{
  "name": "blockrig",
  "version": "0.3.0",
  "description": "Make Roblox-style story videos fast and good in three.js: R15/R6 characters that wear real Roblox clothing and play Roblox animations, blockrig/video for Roblox maps, a staging check, layout plans, voice-timed shots and captions, cameras, lighting and drawn screens, and blockrig/voice for narration takes, pauses, pitch and pace.",
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./video": {
      "types": "./src/video/index.d.ts",
      "default": "./src/video/index.js"
    },
    "./voice": {
      "types": "./src/voice/index.d.ts",
      "default": "./src/voice/index.js"
    },
    "./umd": "./dist/blockrig.umd.js",
    "./package.json": "./package.json"
  },
  "unpkg": "dist/blockrig.umd.min.js",
  "jsdelivr": "dist/blockrig.umd.min.js",
  "types": "./src/index.d.ts",
  "files": [
    "src",
    "dist",
    "README.md",
    "CHANGELOG.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/test.mjs",
    "test:update": "node scripts/test.mjs --update",
    "screenshots": "node scripts/screenshots.mjs",
    "demo": "node scripts/serve.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "roblox",
    "roblox-video",
    "shorts",
    "narration",
    "tts",
    "story",
    "remotion",
    "three",
    "threejs",
    "r15",
    "r6",
    "rig",
    "animation",
    "layered-clothing",
    "roblox-map",
    "rbxm",
    "mesh",
    "blocky",
    "character",
    "facial-expressions"
  ],
  "author": "dimasma0305",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dimasma0305/blockrig.git"
  },
  "homepage": "https://github.com/dimasma0305/blockrig#readme",
  "bugs": {
    "url": "https://github.com/dimasma0305/blockrig/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "three": ">=0.128.0"
  },
  "devDependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "esbuild": "0.27.0",
    "playwright-core": "1.63.0",
    "three": "0.184.0"
  }
}
