{
  "name": "blockrig-ctf-example",
  "version": "1.0.0",
  "description": "In this world, everybody plays CTF: a narrated short made with BlockRig, React Three Fiber and Remotion",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "new": "node scripts/new-video.mjs",
    "docs": "node scripts/docs.mjs",
    "setup-voice": "node scripts/setup-voice.mjs",
    "voice": "node scripts/docs.mjs && node scripts/voice.mjs",
    "assets": "node scripts/fetch-assets.mjs",
    "roblox": "node scripts/fetch-roblox.mjs",
    "studio": "node scripts/docs.mjs && remotion studio",
    "stills": "node scripts/docs.mjs && node scripts/stills.mjs",
    "check": "node scripts/docs.mjs && node scripts/check.mjs && tsc --noEmit",
    "render": "node scripts/docs.mjs && node scripts/render.mjs",
    "preview": "node scripts/preview.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.544",
    "@remotion/cli": "4.0.544",
    "@remotion/google-fonts": "4.0.544",
    "@remotion/media": "4.0.544",
    "@remotion/renderer": "4.0.544",
    "@remotion/three": "4.0.544",
    "@react-three/fiber": "9.8.2",
    "blockrig": "file:../..",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.544",
    "three": "0.184.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/three": "0.184.0",
    "typescript": "5.9.3"
  }
}
