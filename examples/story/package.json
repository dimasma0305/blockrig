{
  "name": "blockrig-story-example",
  "version": "1.0.0",
  "description": "A narrated short made with BlockRig, React Three Fiber and Remotion",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "studio": "remotion studio",
    "assets": "node scripts/fetch-assets.mjs",
    "voice": "node scripts/make-audio.mjs",
    "stills": "node scripts/stills.mjs",
    "render": "remotion render Story out/story.mp4 --crf=18",
    "preview": "node scripts/preview.mjs",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@remotion/cli": "4.0.544",
    "@remotion/google-fonts": "4.0.544",
    "@remotion/media": "4.0.544",
    "@remotion/motion-blur": "4.0.544",
    "@remotion/three": "4.0.544",
    "blockrig": "file:../..",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.544",
    "three": "0.184.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/three": "0.184.0",
    "typescript": "5.9.3"
  }
}
